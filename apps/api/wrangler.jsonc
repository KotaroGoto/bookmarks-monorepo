{
  "name": "bookmarks-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bookmarks",
      "database_id": "local-development-placeholder",
      "migrations_dir": "drizzle",
    },
  ],
  "vars": {
    "ALLOWED_ORIGIN": "http://localhost:5173",
  },
}
